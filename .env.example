# ==========================================================
# SISTEMA DE GESTIÓN DE RECURSOS HUMANOS - TRÓPICO 56
# Plantilla de Configuración de Variables de Entorno (.env)
# ==========================================================
# Instrucciones de uso:
# 1. Duplica este archivo y nómbralo '.env' en la raíz del proyecto:
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
# 2. Reemplaza los valores con la configuración de tu entorno local o servidor.
# 3. No compartas ni subas tu archivo '.env' real a repositorios públicos.
# ==========================================================

# ==========================================
# 1. CONFIGURACIÓN DEL SERVIDOR WEB
# ==========================================
# Puerto en el que se ejecuta la aplicación Express (por defecto: 3000)
PORT=3000

# Entorno de ejecución: 'development' (desarrollo) o 'production' (producción)
NODE_ENV=development

# ==========================================
# 2. CONEXIÓN A BASE DE DATOS (MySQL)
# ==========================================
# Host o dirección IP del servidor MySQL (ejemplo: localhost o 127.0.0.1)
DB_HOST=localhost

# Puerto de conexión a MySQL (por defecto: 3306)
DB_PORT=3306

# Nombre de la base de datos del sistema
DB_NAME=tropico_sgrh

# Usuario de MySQL con permisos sobre la base de datos
DB_USER=root

# Contraseña del usuario de MySQL
DB_PASSWORD=tu_contraseña_aqui

# ==========================================
# 3. SEGURIDAD, AUTENTICACIÓN Y SESIONES (JWT)
# ==========================================
# Clave secreta para la firma y verificación de tokens JSON Web Token (JWT)
JWT_SECRET=tu_clave_secreta_super_segura_cambiar_en_produccion

# Tiempo de expiración del token de sesión (ejemplos: '24h', '8h', '7d')
JWT_EXPIRES_IN=24h
